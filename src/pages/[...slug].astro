---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { ArticleIcon } from "../components/ArticleCard";
import { SeriesNav, SeriesPrevNext } from "../components/SeriesNav";
import { Toc } from "../components/Toc";
import { articleId, getPublishedArticles } from "../lib/articles/collections";
import { getSeriesForArticle } from "../lib/articles/index-tree";
import { resolveIcon } from "../lib/emoji";
import { formatJaDate } from "../lib/util";
import Base from "./_base.astro";

export const getStaticPaths = (async () => {
  const entries = await getPublishedArticles();
  return entries.map((entry) => ({
    params: { slug: articleId(entry) },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);

const { title, abst, date, icon } = entry.data;
const dateLabel = formatJaDate(date);
const series = await getSeriesForArticle(entry);
const resolvedIcon = resolveIcon(icon);
---

<Base title={title} description={abst}>
  <article>
    <header class="mb-4">
      <h1
        class="flex items-center gap-3 rounded bg-fuchsia-100 px-3 py-1.5 text-2xl leading-tight font-bold text-fuchsia-900 dark:bg-fuchsia-900/40 dark:text-fuchsia-100"
      >
        {resolvedIcon && <ArticleIcon icon={resolvedIcon} className="shrink-0 text-3xl leading-none" imgClass="h-9 w-9" />}
        <span>{title}</span>
      </h1>
      <div class="mt-1 flex items-center gap-3 px-1 text-sm text-slate-700 dark:text-slate-400">
        {dateLabel && <time>{dateLabel}</time>}
        {abst && <span class="truncate">{abst}</span>}
      </div>
    </header>
    {series && (
      <div class="xl:hidden">
        <SeriesNav series={series} />
      </div>
    )}
    <div class="mb-4 xl:hidden">
      <Toc client:load headings={headings} />
    </div>

    <div class="prose dark:prose-invert max-w-none">
      <Content />
    </div>

    {series && <SeriesPrevNext series={series} />}
  </article>

  {series && (
    <aside
      class="pointer-events-none fixed inset-y-0 right-[calc(50%+28rem)] z-10 hidden w-48 items-start xl:flex min-[1440px]:w-60 2xl:w-64"
    >
      <div class="scrollbar-hide pointer-events-auto mt-14 max-h-[calc(100vh-4rem)] w-full overflow-y-auto px-2">
        <SeriesNav series={series} />
      </div>
    </aside>
  )}

  <aside
    class="pointer-events-none fixed inset-y-0 left-[calc(50%+28rem)] z-10 hidden w-48 items-start xl:flex 2xl:w-56"
  >
    <div class="scrollbar-hide pointer-events-auto mt-14 max-h-[calc(100vh-4rem)] w-full overflow-y-auto px-2">
      <Toc client:load headings={headings} />
    </div>
  </aside>
</Base>
