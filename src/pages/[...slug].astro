---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import Base from "./_base.astro";
import { Toc } from "../components/Toc";
import { formatJaDate } from "../lib/format-date";
import { getPublishedArticles } from "../lib/articles/collections";

export const getStaticPaths = (async () => {
  const entries = await getPublishedArticles();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props as Props;
const { Content, headings } = await render(entry);

const { title, abst, date, ogp, toc } = entry.data;
const dateLabel = formatJaDate(date);
const showToc = toc !== false;
---

<Base title={title} description={abst} ogp={ogp}>
  <article
    class="rounded-lg border border-sky-200/60 bg-white p-5 shadow-sm dark:border-zinc-700 dark:bg-zinc-800 sm:p-8"
  >
    <header class="mb-6">
      <h1
        class="rounded bg-fuchsia-200 px-3 py-2 text-2xl font-bold leading-tight text-fuchsia-800 dark:bg-fuchsia-950 dark:text-fuchsia-200"
      >
        {title}
      </h1>
      <div class="mt-2 flex items-center gap-3 px-1 text-sm text-neutral-900/70 dark:text-zinc-100/70">
        {dateLabel && <time>{dateLabel}</time>}
        {abst && <span class="truncate">{abst}</span>}
      </div>
    </header>

    {
      showToc && (
        <div class="mb-8 xl:hidden">
          <Toc client:load headings={headings} />
        </div>
      )
    }

    <div class="prose max-w-none dark:prose-invert">
      <Content />
    </div>
  </article>

  {
    showToc && (
      <aside class="pointer-events-none fixed inset-y-0 left-[calc(50%+28rem)] z-10 hidden w-48 items-start xl:flex 2xl:w-56">
        <div class="pointer-events-auto mt-24 max-h-[calc(100vh-7rem)] w-full overflow-y-auto px-2">
          <Toc client:load headings={headings} />
        </div>
      </aside>
    )
  }
</Base>
