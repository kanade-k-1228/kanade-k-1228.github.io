---
import Base from "./_base.astro";
import { ArticleIndex } from "../components/ArticleIndex";
import { FeaturedList } from "../components/FeaturedList";
import { NewsBoard } from "../components/NewsBoard";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getFeatured } from "../lib/articles/featured";
import { buildIndex } from "../lib/articles/index-tree";
import { news } from "../lib/news";

const featured = await getFeatured();
const sections = await buildIndex();
---

<Base>
  <section class="mb-12">
    <h1
      class="rounded bg-fuchsia-100 px-3 py-2 text-4xl font-bold leading-tight text-fuchsia-900 dark:bg-fuchsia-900/40 dark:text-fuchsia-100"
    >
      {SITE_TITLE}
    </h1>
    <p class="mt-3 px-1 text-slate-700 dark:text-slate-300">{SITE_DESCRIPTION}</p>
  </section>

  <FeaturedList items={featured} />
  <NewsBoard items={news} client:load />
  <ArticleIndex sections={sections} />
</Base>
