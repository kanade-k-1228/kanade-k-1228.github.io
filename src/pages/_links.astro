---
import Base from "./_base.astro";

interface Props {
  frontmatter: { title: string; description?: string };
}

const { frontmatter } = Astro.props as Props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <article
    class="rounded-lg border border-sky-200/60 bg-white p-5 shadow-sm dark:border-zinc-700 dark:bg-zinc-800 sm:p-8"
  >
    <header class="mb-6">
      <h1
        class="rounded bg-fuchsia-200 px-3 py-2 text-2xl font-bold leading-tight text-fuchsia-800 dark:bg-fuchsia-950 dark:text-fuchsia-200"
      >
        {frontmatter.title}
      </h1>
    </header>
    <div class="prose max-w-none dark:prose-invert">
      <slot />
    </div>
  </article>
</Base>
